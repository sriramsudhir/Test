// @category Volatility
// @description Keltner Channels: EMA basis with ATR envelopes.
//@version=6
indicator("Keltner Channels", shorttitle="KC", overlay=true)
len = input.int(20, "Length", minval=1)
mult = input.float(2.0, "Multiplier")
atrLen = input.int(10, "ATR Length", minval=1)
basis = ta.ema(close, len)
rangeMa = ta.atr(atrLen)
plot(basis, "Basis", color=color.blue)
u = plot(basis + rangeMa * mult, "Upper", color=color.teal)
l = plot(basis - rangeMa * mult, "Lower", color=color.teal)
fill(u, l, color=color.new(color.teal, 92), title="Background")
