// @category Volatility
// @description Bollinger Bands: SMA basis with standard-deviation envelopes.
//@version=6
indicator("Bollinger Bands", shorttitle="BB", overlay=true)
len = input.int(20, "Length", minval=1)
mult = input.float(2.0, "StdDev", minval=0.001)
src = input.source(close, "Source")
basis = ta.sma(src, len)
dev = mult * ta.stdev(src, len)
plot(basis, "Basis", color=color.orange)
u = plot(basis + dev, "Upper", color=color.blue)
l = plot(basis - dev, "Lower", color=color.blue)
fill(u, l, color=color.new(color.blue, 92), title="Background")
