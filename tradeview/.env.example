# TradeView configuration. Copy to .env and fill in what you need.
# Every value is optional; an empty value means "use the built-in default" (shown in the comment).
# Never commit your real .env.

# ---------------------------------------------------------------- server
# HTTP port for the API, WebSocket and the Next.js web app (default 3000)
PORT=
# Bind address (default 0.0.0.0)
HOST=
# SQLite database file, relative to this folder (default ./data/tradeview.db)
DB_PATH=
# pino log level: trace|debug|info|warn|error (default info)
LOG_LEVEL=
# off = serve the API only, without the Next.js web app (same as `node server/src/index.js --no-web`)
WEB=
# Set to true (or a hop count / CIDR list) when running behind a reverse proxy, so client IPs and https are detected
TRUST_PROXY=

# ---------------------------------------------------------------- site login (strongly recommended on the internet)
# Either a plain password...
AUTH_PASSWORD=
# ...or an scrypt hash from: node server/src/auth/hash.js
AUTH_PASSWORD_HASH=
# Secret used to sign session cookies (default: generated once and stored in the database)
SESSION_SECRET=
# Session length in days (default 30)
SESSION_DAYS=
# Secure cookie flag: auto (Secure when the request is HTTPS) | true | false (default auto)
COOKIE_SECURE=

# ---------------------------------------------------------------- Delta Exchange (primary market data)
# india | global (default india)
DELTA_REGION=
# REST base URL (default https://api.india.delta.exchange; global: https://api.delta.exchange)
DELTA_REST=
# WebSocket URL (default wss://socket.india.delta.exchange; global: wss://socket.delta.exchange)
DELTA_WS=
# Delta REST requests per second (default 8)
DELTA_RATE_LIMIT=
# Optional placeholders only: public market data needs no key. Never logged.
DELTA_API_KEY=
DELTA_API_SECRET=

# ---------------------------------------------------------------- Bybit (second provider)
# REST base URL (default https://api.bybit.com)
BYBIT_REST=
# Public WebSocket base (default wss://stream.bybit.com/v5/public)
BYBIT_WS=
# Trade dump host used by `npm run backfill -- --footprint` (default https://public.bybit.com)
BYBIT_DUMPS=
# Bybit REST requests per second (default 10)
RATE_LIMIT=

# ---------------------------------------------------------------- symbols, history, recording
# Comma list of symbol keys or selectors: delta:BTCUSD, linear:BTCUSDT, delta:top:10, top:20, group:commodities
# (default delta:BTCUSD,delta:ETHUSD,delta:SOLUSD,delta:XRPUSD,delta:BNBUSD,delta:DOGEUSD)
DEFAULT_SYMBOLS=
# Symbols whose live trades are recorded 24/7 into footprint + raw trades (default = DEFAULT_SYMBOLS)
RECORD_SYMBOLS=
# Days of raw recorded trades to keep (default 30)
TRADES_RETENTION_DAYS=
# History depth for `npm run backfill` (default 365)
BACKFILL_DAYS=
# Footprint bucket = tickSize x this integer, or auto (default auto, about 2 bps of price)
FOOTPRINT_TICK_MULT=
# 0 = skip the startup gap fill (default 1)
GAPFILL_ON_START=

# ---------------------------------------------------------------- Claude agent
# claude-code (your Claude Pro/Max login via the Agent SDK) | anthropic-api | off (default claude-code)
AGENT_DRIVER=
# Model id (default claude-opus-5-5)
CLAUDE_MODEL=
# Optional reasoning effort hint for the agent driver
CLAUDE_EFFORT=
# claude-code driver: token from `claude setup-token` (alternative to logging in with the `claude` CLI)
CLAUDE_CODE_OAUTH_TOKEN=
# claude-code driver: custom Claude config directory (optional)
CLAUDE_CONFIG_DIR=
# anthropic-api driver: API key. If set, the Agent SDK also uses it instead of your subscription login.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Laya decision gate for alerts
# local (@receptron/laya ONNX in-process) | http (laya-serve) | off (default local)
LAYA_MODE=
# laya-serve URL for LAYA_MODE=http (default http://127.0.0.1:8000)
LAYA_URL=
# Default probability threshold for alerts (default 0.6)
LAYA_THRESHOLD=

# ---------------------------------------------------------------- alert notifications
# Web Push contact, mailto: or https: URL (VAPID keys are generated automatically and stored in the DB)
VAPID_SUBJECT=
# Optional Telegram message on every fired alert
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
